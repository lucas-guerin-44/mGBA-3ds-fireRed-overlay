<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_slot_bg"
    android:padding="16dp"
    android:layout_marginBottom="10dp">

    <!-- Slot header: label + scan button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/slot_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#6080C0"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <Button
            android:id="@+id/btn_scan"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="Scan"
            android:textSize="12sp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            style="?android:attr/buttonBarNeutralButtonStyle" />

    </LinearLayout>

    <!-- Empty state hint -->
    <TextView
        android:id="@+id/card_empty_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No Pokémon walking"
        android:textColor="#40405A"
        android:textSize="13sp"
        android:layout_marginBottom="4dp" />

    <!-- Active: sprite + name/level/stats compact row -->
    <LinearLayout
        android:id="@+id/card_active_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/slot_sprite"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:scaleType="fitCenter" />

        <!-- Name / level / species -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/slot_nickname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/slot_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#9090B0"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/slot_species"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#50506A"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- Steps / XP compact -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/slot_steps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#40C060"
                android:textSize="15sp"
                android:textStyle="bold"
                android:gravity="end" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="steps"
                android:textColor="#30304A"
                android:textSize="10sp"
                android:gravity="end" />

            <TextView
                android:id="@+id/slot_xp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#C0A020"
                android:textSize="13sp"
                android:gravity="end"
                android:layout_marginTop="2dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Active: route row -->
    <LinearLayout
        android:id="@+id/card_route_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/slot_route"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#5070A0"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_change_route"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:text="Route"
            android:textSize="11sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            style="?android:attr/buttonBarNeutralButtonStyle" />

    </LinearLayout>

    <!-- Active: items found (single line) -->
    <TextView
        android:id="@+id/slot_items"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#606080"
        android:textSize="12sp"
        android:layout_marginBottom="12dp"
        android:visibility="gone" />

    <!-- Divider -->
    <View
        android:id="@+id/card_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#282840"
        android:layout_marginBottom="10dp"
        android:visibility="gone" />

    <!-- Active: return button (subtle) -->
    <Button
        android:id="@+id/btn_return"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:text="Return to Game"
        android:textSize="13sp"
        android:visibility="gone"
        style="?android:attr/buttonBarNeutralButtonStyle" />

</LinearLayout>
